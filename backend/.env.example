# ── Database ────────────────────────────────────────────────
# Local dev (SQLite):
DATABASE_URL=sqlite:///./opportunities.db
# Docker Compose / production (Postgres):
# DATABASE_URL=postgresql+psycopg2://opportunity:opportunity@localhost:5432/opportunityfinder

# ── Google Custom Search API (optional) ─────────────────────
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_CSE_ID=your_custom_search_engine_id_here

# ── Scraping behaviour ───────────────────────────────────────
SCRAPE_INTERVAL_HOURS=6
MAX_RESULTS_PER_QUERY=10
REQUEST_DELAY_SECONDS=2.0
REQUEST_TIMEOUT=15
MAX_RETRIES=3
RSS_MAX_ENTRIES_PER_FEED=25

# ── Email alerts (optional) ──────────────────────────────────
# Leave all unset to log emails instead of sending them (see
# app/services/email_sender.py). Set one to send for real — if more
# than one is set, Resend takes priority, then Brevo.
# RESEND_API_KEY=your_resend_api_key_here
# BREVO_API_KEY=your_brevo_api_key_here
# SENDGRID_API_KEY=your_sendgrid_api_key_here
# ALERT_FROM_EMAIL=Global Opportunities <alerts@yourdomain.com>

# ── Admin login (analytics + moderation queue) ──────────────
# All three required together for admin login; unset means admin
# endpoints refuse every request. Generate ADMIN_PASSWORD_HASH with
# `scripts/hash_admin_password.py`.
# ADMIN_EMAIL=admin@yourdomain.com
# ADMIN_PASSWORD_HASH=pbkdf2$600000$salt_hex$hash_hex
# SESSION_SECRET_KEY=your_random_secret_here
#
# Optional TOTP second factor on top of the password. Leave unset for
# password-only login (the default, unchanged). Generate a secret plus
# a QR-code provisioning URI with `scripts/generate_admin_totp_secret.py`.
# ADMIN_TOTP_SECRET=your_base32_totp_secret_here

# ── Deployment ──────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
# Cloud platforms often set PORT instead of API_PORT:
# PORT=8000
ENABLE_SCHEDULER=true
CORS_ORIGINS=*
